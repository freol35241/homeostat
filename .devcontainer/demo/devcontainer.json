// The starter house with simulated devices, one click from the README's
// "Open in Codespaces" button (examples/starter-house/demo/README.md).
// Nothing is built: it runs the released homeostat image beside a
// simulator under Docker, and opens the dashboard when its port forwards.
// For working on homeostat itself, use the default container instead.
{
	"name": "homeostat demo",
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4": {}
	},
	"hostRequirements": { "cpus": 2, "memory": "4gb" },
	// Every start, not just the first: up.sh reuses the house it copied
	// out on a resumed codespace and only brings the containers back up.
	"postStartCommand": "examples/starter-house/demo/up.sh",
	"forwardPorts": [8600],
	"portsAttributes": {
		"8600": { "label": "dashboard", "onAutoForward": "openBrowser" }
	},
	"otherPortsAttributes": { "onAutoForward": "silent" }
}
