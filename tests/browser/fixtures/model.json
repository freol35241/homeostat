   "kind": "automation",
   "description": "Turns downstairs lights off after off_time when nobody is present",
   "params": {
    "off_time": {
     "type": "time",
     "default": "22:00",
     "constraint": {
      "after": "20:00",
      "before": "02:00"
     },
     "editable_by": "family"
    },
    "grace_minutes": {
     "type": "int",
     "default": 5,
     "constraint": {
      "min": 0,
      "max": 60
     },
     "editable_by": "family"
    }
